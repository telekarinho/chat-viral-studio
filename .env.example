# Raiz — usado pelo docker-compose. Copie para .env e preencha o que quiser.
# (Para dev sem Docker, edite backend/.env e web/.env.local separadamente.)

GEMINI_API_KEY=
GOOGLE_TTS_API_KEY=

# ---------------------------------------------------------------------------
# Post.ai (apps/api + apps/mobile). Never commit real values.
# ---------------------------------------------------------------------------
# API server only (secrets):
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RATE_LIMIT_MAX=30
PORT=3333
# Service role is only for CI tests / privacy-erasure worker — never in the app or the API request path:
SUPABASE_SERVICE_ROLE_KEY=

# Mobile build (public values, baked into the APK; the anon key is public by design, RLS protects data):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SENTRY_DSN=
