{
  "name": "postai-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "Post.ai — creator copilot (mobile + api + domain). Legacy Chat Viral Studio lives in web/, backend/ and android/ with their own lockfiles.",
  "workspaces": [
    "packages/domain",
    "apps/api",
    "apps/worker",
    "apps/mobile"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  }
}
