{
  "name": "@postai/api",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --outfile=dist/main.js --external:@nestjs/* --external:openai --external:@supabase/* --external:reflect-metadata --external:rxjs --external:zod --external:express --external:class-validator --external:class-transformer",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.mjs src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@postai/domain": "0.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "openai": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "supertest": "^7.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.4"
  }
}
